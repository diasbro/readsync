[
  {
    "name": "newest value of each key wins, whichever device wrote it",
    "edition": "e1",
    "files": [
      {"pos": 100, "posAt": 10, "mode": "audio", "modeAt": 50},
      {"pos": 900, "posAt": 20, "mode": "pages", "modeAt": 40}
    ],
    "merged": {"pos": 900, "posAt": 20, "mode": "audio", "modeAt": 50}
  },
  {
    "name": "statistics add up across devices, each file holding only its own sessions",
    "edition": "",
    "files": [
      {"stats": {"days": {"2026-10-01": {"sec": 60, "words": 100}}}},
      {"stats": {"days": {"2026-10-01": {"sec": 30, "words": 50}, "2026-10-02": {"sec": 5, "words": 7}}}}
    ],
    "merged": {"stats": {"days": {"2026-10-01": {"sec": 90.0, "words": 150.0}, "2026-10-02": {"sec": 5.0, "words": 7.0}}}}
  },
  {
    "name": "a sentence position from another edition of the text is dropped",
    "edition": "e2",
    "files": [
      {"sent": 500, "sentAt": 90, "sentPct": 40, "sentEdition": "e1"},
      {"sent": 12, "sentAt": 10, "sentPct": 1, "sentEdition": "e2"}
    ],
    "merged": {"sent": 12, "sentAt": 10, "sentPct": 1, "sentEdition": "e2"}
  },
  {
    "name": "sentPct travels with the sent that wins",
    "edition": "e1",
    "files": [
      {"sent": 5, "sentAt": 100, "sentPct": 3, "sentEdition": "e1"},
      {"sent": 900, "sentAt": 50, "sentPct": 99, "sentEdition": "e1"}
    ],
    "merged": {"sent": 5, "sentAt": 100, "sentPct": 3, "sentEdition": "e1"}
  },
  {
    "name": "keys outside the merge, such as old per-book settings, do not come through",
    "edition": "",
    "files": [{"settings": {"font": 30}, "settingsAt": 9, "shelf": "reading", "shelfAt": 3}],
    "merged": {"shelf": "reading", "shelfAt": 3}
  },
  {
    "name": "on equal times the earlier file in name order keeps its value",
    "edition": "",
    "files": [
      {"pos": 100, "posAt": 10, "shelf": "reading", "shelfAt": 7},
      {"pos": 900, "posAt": 10, "shelf": "done", "shelfAt": 7}
    ],
    "merged": {"pos": 100, "posAt": 10, "shelf": "reading", "shelfAt": 7}
  },
  {
    "name": "the finished list wins whole by finishedAt: the phone's newer list replaces the Mac's",
    "edition": "",
    "files": [
      {"finished": ["2026-03-12"], "finishedAt": 10},
      {"finished": ["2026-03-12", "2026-10-07"], "finishedAt": 20}
    ],
    "merged": {"finished": ["2026-03-12", "2026-10-07"], "finishedAt": 20}
  },
  {
    "name": "an undo: a newer shorter finished list replaces an older longer one",
    "edition": "",
    "files": [
      {"finished": ["2026-03-12", "2026-10-07"], "finishedAt": 20, "shelf": "done", "shelfAt": 20},
      {"finished": ["2026-03-12"], "finishedAt": 30, "shelf": "reading", "shelfAt": 30}
    ],
    "merged": {"finished": ["2026-03-12"], "finishedAt": 30, "shelf": "reading", "shelfAt": 30}
  },
  {
    "name": "a shelf done older than a shelf reading loses to it",
    "edition": "",
    "files": [
      {"shelf": "reading", "shelfAt": 40},
      {"shelf": "done", "shelfAt": 30, "finished": ["2026-10-07"], "finishedAt": 30}
    ],
    "merged": {"shelf": "reading", "shelfAt": 40, "finished": ["2026-10-07"], "finishedAt": 30}
  },
  {
    "name": "a sentence from an edition editions.json maps is translated and counts as the current edition's",
    "edition": "e3",
    "editions": {"edition": "e3", "maps": {"e1": [0, 0, 1, 4, 4, 7], "e2": [0, 2, 3]}},
    "files": [
      {"sent": 3, "sentAt": 90, "sentPct": 40, "sentEdition": "e1"},
      {"sent": 1, "sentAt": 10, "sentPct": 1, "sentEdition": "e3"}
    ],
    "merged": {"sent": 4, "sentAt": 90, "sentPct": 40, "sentEdition": "e3"}
  },
  {
    "name": "a sentence past the end of the map takes the map's last place",
    "edition": "e3",
    "editions": {"edition": "e3", "maps": {"e2": [0, 2, 3]}},
    "files": [{"sent": 50, "sentAt": 20, "sentPct": 99, "sentEdition": "e2"}],
    "merged": {"sent": 3, "sentAt": 20, "sentPct": 99, "sentEdition": "e3"}
  },
  {
    "name": "a sentence from an edition the map does not name is still dropped",
    "edition": "e3",
    "editions": {"edition": "e3", "maps": {"e2": [0, 2, 3]}},
    "files": [
      {"sent": 1, "sentAt": 90, "sentPct": 5, "sentEdition": "e1"},
      {"sent": 7, "sentAt": 10, "sentPct": 2, "sentEdition": "e3"}
    ],
    "merged": {"sent": 7, "sentAt": 10, "sentPct": 2, "sentEdition": "e3"}
  },
  {
    "name": "a merge in an edition the map names, an older copy's, does not use the map",
    "edition": "e1",
    "editions": {"edition": "e2", "maps": {"e1": [0, 5, 9]}},
    "files": [
      {"sent": 2, "sentAt": 10, "sentPct": 3, "sentEdition": "e1"},
      {"sent": 9, "sentAt": 90, "sentPct": 80, "sentEdition": "e2"}
    ],
    "merged": {"sent": 2, "sentAt": 10, "sentPct": 3, "sentEdition": "e1"}
  },
  {
    "name": "a sentence that names no edition is taken as it is, map or not",
    "edition": "e2",
    "editions": {"edition": "e2", "maps": {"e1": [5]}},
    "files": [{"sent": 0, "sentAt": 5, "sentPct": 0}],
    "merged": {"sent": 0, "sentAt": 5, "sentPct": 0, "sentEdition": "e2"}
  },
  {
    "name": "maps leading to another edition than the book's (a text replaced since) are not used",
    "edition": "e3",
    "editions": {"edition": "e2", "maps": {"e1": [0, 5, 9, 12]}},
    "files": [
      {"sent": 2, "sentAt": 50, "sentPct": 10, "sentEdition": "e1"},
      {"sent": 7, "sentAt": 10, "sentPct": 3, "sentEdition": "e3"}
    ],
    "merged": {"sent": 7, "sentAt": 10, "sentPct": 3, "sentEdition": "e3"}
  },
  {
    "name": "the merged sentence names the edition it counts in, none for a book without one",
    "edition": "",
    "files": [{"sent": 4, "sentAt": 5, "sentPct": 1, "sentEdition": "e1"}],
    "merged": {"sent": 4, "sentAt": 5, "sentPct": 1, "sentEdition": ""}
  }
]
